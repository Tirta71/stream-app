generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER  @map("user")
  ADMIN @map("admin")
}

enum AuthProvider {
  EMAIL  @map("email")
  GOOGLE @map("google")
}

enum ContentType {
  MOVIE  @map("movie")
  SERIES @map("series")
}

enum PersonRole {
  CAST     @map("cast")
  DIRECTOR @map("director")
  CREATOR  @map("creator")
}

enum OrderStatus {
  PENDING   @map("pending")
  PAID      @map("paid")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")
}

enum PaymentStatus {
  PENDING @map("pending")
  PAID    @map("paid")
  FAILED  @map("failed")
  EXPIRED @map("expired")
}

enum SubscriptionStatus {
  ACTIVE    @map("active")
  EXPIRED   @map("expired")
  CANCELLED @map("cancelled")
}

model User {
  id            BigInt             @id @default(autoincrement())
  name          String             @db.VarChar(100)
  email         String             @unique @db.VarChar(150)
  password      String?            @db.VarChar(255)
  role          UserRole           @default(USER)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  authProviders UserAuthProvider[]
  myLists       MyList[]
  orders        Order[]
  subscriptions Subscription[]
  watchProgress WatchProgress[]

  @@map("users")
}

model UserAuthProvider {
  id             BigInt       @id @default(autoincrement())
  userId         BigInt       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id") @db.VarChar(255)
  providerEmail  String?      @map("provider_email") @db.VarChar(150)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("users_auth_providers")
}

model Package {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(100)
  price        Decimal        @db.Decimal(12, 2)
  durationDays Int            @map("duration_days")
  quality      String         @db.VarChar(50)
  maxDevices   Int            @map("max_devices")
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  orders       Order[]
  subscriptions Subscription[]

  @@map("packages")
}

model Order {
  id               BigInt      @id @default(autoincrement())
  userId           BigInt      @map("user_id")
  packageId        BigInt      @map("package_id")
  orderCode        String      @unique @map("order_code") @db.VarChar(100)
  totalPrice       Decimal     @map("total_price") @db.Decimal(12, 2)
  status           OrderStatus @default(PENDING)
  paymentExpiredAt DateTime?   @map("payment_expired_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  package          Package     @relation(fields: [packageId], references: [id])
  payments         Payment[]
  subscription     Subscription?

  @@map("orders")
}

model Payment {
  id             BigInt        @id @default(autoincrement())
  orderId        BigInt        @map("order_id")
  paymentMethod  String        @map("payment_method") @db.VarChar(100)
  paymentGateway String?       @map("payment_gateway") @db.VarChar(100)
  transactionId  String?       @map("transaction_id") @db.VarChar(150)
  amount         Decimal       @db.Decimal(12, 2)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?     @map("paid_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Subscription {
  id        BigInt             @id @default(autoincrement())
  userId    BigInt             @map("user_id")
  packageId BigInt             @map("package_id")
  orderId   BigInt             @unique @map("order_id")
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @map("started_at")
  endedAt   DateTime           @map("ended_at")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  package   Package            @relation(fields: [packageId], references: [id])
  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model SeriesFilm {
  id            BigInt             @id @default(autoincrement())
  slug          String             @unique @db.VarChar(150)
  title         String             @db.VarChar(200)
  type          ContentType
  description   String             @db.Text
  image         String             @db.Text
  previewImage  String             @map("preview_image") @db.Text
  rating        Decimal            @db.Decimal(3, 1)
  ageRating     String             @map("age_rating") @db.VarChar(10)
  badge         String?            @db.VarChar(50)
  releaseYear   Int?               @map("release_year")
  isTopTen      Boolean            @default(false) @map("is_top_ten")
  isActive      Boolean            @default(true) @map("is_active")
  isTrending    Boolean            @default(false) @map("is_trending")
  isPremium     Boolean            @default(false) @map("is_premium")
  trailerUrl    String?            @map("trailer_url") @db.Text
  publishedAt   DateTime           @map("published_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  episodes      EpisodeMovie[]
  genres        SeriesFilmGenre[]
  myLists       MyList[]
  people        SeriesFilmPerson[]
  watchProgress WatchProgress[]

  @@map("series_films")
}

model EpisodeMovie {
  id            BigInt          @id @default(autoincrement())
  seriesFilmId  BigInt          @map("series_film_id")
  title         String          @db.VarChar(200)
  description   String?         @db.Text
  seasonNumber  Int?            @map("season_number")
  episodeNumber Int?            @map("episode_number")
  duration      String          @db.VarChar(50)
  videoUrl      String?         @map("video_url") @db.Text
  thumbnailUrl  String?         @map("thumbnail_url") @db.Text
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  seriesFilm    SeriesFilm      @relation(fields: [seriesFilmId], references: [id], onDelete: Cascade)
  watchProgress WatchProgress[]

  @@map("episode_movies")
}

model Genre {
  id        BigInt            @id @default(autoincrement())
  name      String            @db.VarChar(100)
  slug      String            @unique @db.VarChar(120)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  contents  SeriesFilmGenre[]

  @@map("genres")
}

model SeriesFilmGenre {
  id           BigInt     @id @default(autoincrement())
  seriesFilmId BigInt     @map("series_film_id")
  genreId      BigInt     @map("genre_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  seriesFilm   SeriesFilm @relation(fields: [seriesFilmId], references: [id], onDelete: Cascade)
  genre        Genre      @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@map("series_film_genres")
}

model Person {
  id        BigInt             @id @default(autoincrement())
  name      String             @db.VarChar(150)
  photoUrl  String?            @map("photo_url") @db.Text
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  contents  SeriesFilmPerson[]

  @@map("people")
}

model SeriesFilmPerson {
  id            BigInt     @id @default(autoincrement())
  seriesFilmId  BigInt     @map("series_film_id")
  personId      BigInt     @map("people_id")
  role          PersonRole
  characterName String?    @map("character_name") @db.VarChar(150)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")
  seriesFilm    SeriesFilm @relation(fields: [seriesFilmId], references: [id], onDelete: Cascade)
  person        Person     @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("series_film_people")
}

model MyList {
  id           BigInt     @id @default(autoincrement())
  userId       BigInt     @map("user_id")
  seriesFilmId BigInt     @map("series_film_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesFilm   SeriesFilm @relation(fields: [seriesFilmId], references: [id], onDelete: Cascade)

  @@map("my_lists")
}

model WatchProgress {
  id                  BigInt        @id @default(autoincrement())
  userId              BigInt        @map("user_id")
  seriesFilmId        BigInt        @map("series_film_id")
  episodeMovieId      BigInt?       @map("episode_movie_id")
  progressPercent     Int           @default(0) @map("progress_percent")
  lastPositionSeconds Int           @default(0) @map("last_position_seconds")
  lastWatchedAt       DateTime?     @map("last_watched_at")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesFilm          SeriesFilm    @relation(fields: [seriesFilmId], references: [id], onDelete: Cascade)
  episodeMovie        EpisodeMovie? @relation(fields: [episodeMovieId], references: [id], onDelete: SetNull)

  @@map("watch_progress")
}
